def what_to_buy(day_type="weekday", weather="sunny"):
    print(f"\n--- VILLA TUNA: BUY FOR TOMORROW: {day_type} / {weather} ---")
    for item, week in data.items():
        # weekday avg = Mon-Thu, weekend avg = Sat-Sun
        weekday_avg = sum(week[0:4]) / 4
        weekend_avg = sum(week[5:7]) / 2
        
        if day_type == "holiday":
            buy = holiday.get(item, int(weekend_avg * 1.4))
        elif day_type == "weekend":
            buy = int(weekend_avg)
        else:
            buy = int(weekday_avg)
        
        # Rainy adjustment
        if weather == "rainy" and item in rainy:
            buy = rainy[item]
            warning = " <- CUT PREP, RAINY DROP"
        elif weather == "rainy" and item in ["Tuna tinola", "Tuna sinigang", "Tuna bicol express"]:
            buy = int(buy * 1.4)
            warning = " <- INCREASE, SOUP DEMAND"
        else:
            warning = ""
        
        # Waste alert for raw items
        waste = ""
        if item in ["Tuna sashimi", "Tuna kinilaw", "Tuna bagaybay"]:
            waste = " [HIGH WASTE RISK - 24-48h only]"
        
        print(f"{item}: Buy {buy}{warning}{waste}")

def chatbot(msg):
    msg = msg.lower()
    if "menu" in msg:
        return "Villa Tuna Menu: Tuna Belly, Tuna Panga, Tuna Kinilaw, Tuna Sisig, Tuna Pancit, Halo Halo, Mango Shake. Open 10AM-9PM daily."
    if "sashimi" in msg or "kinilaw" in msg:
        return "Yes, we have fresh Tuna Sashimi and Kinilaw today. Best to order early, limited fresh stock."
    return "Hello! Type 'menu' to see our SUTUKIL menu."

